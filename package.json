{
  "name": "django-react",
  "version": "1.0.0",
  "description": "Projeto Django usando o React como front.",
  "author": "Nicolas Contiero <https://github.com/ncontiero>",
  "license": "MIT",
  "scripts": {
    "build": "rspack build -c rspack/prod.config.ts",
    "dev": "rspack serve -c rspack/dev.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@ncontiero/eslint-config": "^6.4.0",
    "@rspack/cli": "^1.6.0",
    "@rspack/core": "^1.6.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.38.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.4.0",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack-bundle-tracker": "^3.2.1",
    "webpack-merge": "^6.0.1"
  }
}
